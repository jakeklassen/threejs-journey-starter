{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
	},
	"env": {
		"builtin": true,
		"browser": true,
		"es2024": true
	},
	"ignorePatterns": ["dist", "static"]
}
